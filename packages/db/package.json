{
  "name": "@workspace/db",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && prisma contract emit && tsc -p tsconfig.json && node -e \"fs.copyFileSync('src/prisma/contract.d.ts','dist/src/prisma/contract.d.ts')\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "db:generate": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:migrate": "prisma db migrate",
    "db:deploy": "prisma db migrate",
    "db:verify": "prisma db verify",
    "migration:plan": "prisma migration plan",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:reset": "tsx scripts/wipe-db.ts && prisma db init && tsx src/prisma/seed.ts"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.21",
    "@workspace/logger": "workspace:*",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@prisma/orm-framework": "8.0.0-rc.21",
    "@types/node": "^22",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "prisma": "8.0.0-rc.29",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
