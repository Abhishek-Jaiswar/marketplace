// use prisma-8

// Tied one-to-one to a purchased item, so every review is a verified purchase.
model ProductReview {
  id String @id @onCreate(cuid(2))

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  rating Int
  title  String?
  body   String?
  status ReviewStatus @default(PENDING)

  helpfulCount Int @default(0)

  moderatedById String?
  moderatedBy   User?   @relation(fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt   TimestampString(3)?

  createdAt TimestampString(3) @default(now()) @onCreate(now())
  updatedAt TimestampString(3) @onCreate(now()) @onUpdate(now())

  @@index([productId, status])
  @@index([customerId])
  @@index([moderatedById])
  @@check(expression: sql`"rating" BETWEEN 1 AND 5`, name: "product_review_rating_in_range")
}

model ReviewMedia {
  id String @id @onCreate(cuid(2))

  reviewId String
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([reviewId, mediaId])
  @@index([mediaId])
}

model SellerRating {
  id String @id @onCreate(cuid(2))

  sellerOrderId String      @unique
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt TimestampString(3) @default(now()) @onCreate(now())

  @@index([sellerId])
  @@index([customerId])
  @@check(expression: sql`"rating" BETWEEN 1 AND 5`, name: "seller_rating_in_range")
}
