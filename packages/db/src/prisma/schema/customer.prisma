// use prisma-8

model Customer {
  id          String @id @onCreate(cuid(2))
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String?

  defaultShippingAddressId String? @unique
  defaultBillingAddressId  String? @unique

  defaultShippingAddress Address? @relation("DefaultShippingAddress", fields: [defaultShippingAddressId], references: [id], onDelete: SetNull)
  defaultBillingAddress  Address? @relation("DefaultBillingAddress", fields: [defaultBillingAddressId], references: [id], onDelete: SetNull)

  addresses Address[] @relation("CustomerAddresses")

  createdAt TimestampString(3) @default(now()) @onCreate(now())
  updatedAt TimestampString(3) @onCreate(now()) @onUpdate(now())

  @@index([userId])
}

model Address {
  id          String  @id @onCreate(cuid(2))
  street1     String
  street2     String?
  landmark    String?
  city        String
  state       String
  postalCode  String
  country     String
  phoneNumber String?

  createdAt TimestampString(3) @default(now()) @onCreate(now())
  updatedAt TimestampString(3) @onCreate(now()) @onUpdate(now())

  store Store?

  customerId String?
  customer   Customer? @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade)

  defaultShippingFor Customer? @relation("DefaultShippingAddress")
  defaultBillingFor  Customer? @relation("DefaultBillingAddress")

  @@index([customerId])
}
