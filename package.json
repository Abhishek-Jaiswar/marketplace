{
  "name": "cbs-marketplace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm --filter @workspace/db db:generate && turbo build",
    "dev": "pnpm --filter @workspace/db db:generate && turbo dev",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:contract": "pnpm --filter @workspace/db contract:emit",
    "db:init": "pnpm --filter @workspace/db db:init",
    "db:update": "pnpm --filter @workspace/db db:update",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:verify": "pnpm --filter @workspace/db db:verify",
    "migration:plan": "pnpm --filter @workspace/db migration:plan",
    "db:seed": "pnpm --filter @workspace/db db:seed",
    "db:reset": "pnpm --filter @workspace/db db:reset",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "proper-lockfile>signal-exit": "3.0.7"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
